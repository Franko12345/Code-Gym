# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual env (uv creates .venv)
.venv/
venv/
env/

# pytest
.pytest_cache/
.pytest_cache

# SQLite + data (per ADR-0001: data/ holds seed yaml and runtime DBs).
# data/ is gitignored wholesale. The one exception is
# data/snapshots/noic-fixture.yaml — committed with `git add -f`
# because M2.T3's NOIC scraper needs a checked-in source fixture
# that lives alongside the runtime snapshots it produces.
data/
*.db
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Build / dist
build/
dist/
*.egg-info/

# Deploy hotfix scratch files
*.bak
fix_*.py
bump_v*.py
*scratch*.py

# Future cache-busted CSS directories; historical versions are force-added in the asset commit.
app/static/css/v*/
!app/static/css/v3/
!app/static/css/v3/style.css
!app/static/css/v4/
!app/static/css/v4/style.css
!app/static/css/v5/
!app/static/css/v5/style.css
!app/static/css/v6/
!app/static/css/v6/style.css
